# ---------------------------------------------------------------------------
# StateArk v0.4 - copy to .env. Every value below is OPTIONAL.
# With no .env at all you get local-only Free mode in ~/StateArk.
# ---------------------------------------------------------------------------

PORT=8787

# Bind address. Loopback only by default. Change ONLY if you know why,
# and set a long STATEARK_ACCESS_KEY plus STATEARK_ALLOWED_HOSTS first.
# STATEARK_BIND=127.0.0.1

# Where savepoints live. Leave unset for ~/StateArk.
# STATEARK_LOCAL_ROOT=/Users/you/StateArk

# Leave unset: a random key is generated once and stored in <root>/.access-key.
# Only set this if you want a fixed key (e.g. in a launchd/systemd unit).
# STATEARK_ACCESS_KEY=

# Extra Host / Origin values accepted when the agent sits behind an HTTPS tunnel.
# STATEARK_ALLOWED_HOSTS=stateark.example.com
# STATEARK_ALLOWED_ORIGINS=https://chatgpt.com

# Size guards
# STATEARK_MAX_ARTIFACT_BYTES=67108864
# STATEARK_MAX_UPLOAD_BYTES=104857600

# ---------------------------------------------------------------------------
# Optional Supabase cloud mirror. Cloud sync stays OFF unless all three of
# SUPABASE_URL, SUPABASE_SECRET_KEY and STATEARK_OWNER_ID are set.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
# STATEARK_OWNER_ID=00000000-0000-0000-0000-000000000001
# STATEARK_STORAGE_BUCKET=stateark-artifacts

# Only if the agent is reachable over HTTPS and you want absolute upload links.
# STATEARK_PUBLIC_BASE_URL=
